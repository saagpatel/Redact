<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<!-- C617.1: timestamps of files inside the app container. DocumentStore.loadInProgress()
			     reads contentModificationDate via resourceValues while enumerating JSON files under
			     Documents/documents/in-progress, to pick the most recently modified draft.
			     Not 3B52.1: that reason covers files the user specifically granted access to, such as
			     through a document picker. The only picker here is EditView's
			     UIDocumentPickerViewController(forExporting:), which hands a file out rather than
			     granting access in, and no timestamp read touches a picker-returned URL. Every
			     contentModificationDate read is under DocumentStore's base .documentDirectory.
			     Not DDA9.1: that reason covers displaying file timestamps to the user. The dates shown
			     in the UI come from the document JSON, never from the filesystem. -->
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
